# ==============================================================================
# CONFIGURATION PORTAIL VOYAGEUR - CARRÉ D'HÔTES (EXEMPLE)
# ==============================================================================

# BASE DE DONNÉES MYSQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=votre_base_de_donnees
DB_USER=votre_utilisateur
DB_PASS=VOTRE_MOT_DE_PASSE

# PARAMÈTRES DE L'APPLICATION
APP_NAME="Carré d'Hôtes - Portail Voyageurs"
APP_URL=https://carredhotes.fr/portail
APP_ENV=production
APP_DEBUG=false

# PASSERELLE SÉCURISÉE (OPTIONNELLE)
GATEWAY_API_KEY=votre_cle_api_secrete

# DÉPLOIEMENT FTP OVH (SECRETS GITHUB ACTIONS)
FTP_SERVER=votre_serveur_ftp
FTP_USERNAME=votre_login_ftp
FTP_PORT=21

