# Passerelle Carré d'Hôtes — protection des fichiers sensibles
Options -Indexes

<FilesMatch "^(config\.php|gateway-log.*|\.env.*|.*\.md|.*\.log|.*\.off|.*\.bak|.*\.backup|.*\.old)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
